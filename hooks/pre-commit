#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# SPDX-FileCopyrightText: 2026 CYD32 contributors
# Install: ln -s ../../hooks/pre-commit .git/hooks/pre-commit
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
list="$HOME/.config/cyd32/denylist.txt"
if [[ -s "$list" ]]; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  files=()
  while IFS= read -r -d '' f; do
    mkdir -p "$tmp/$(dirname "$f")"; git show ":$f" > "$tmp/$f" 2>/dev/null || continue; files+=("$f")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)
  if (( ${#files[@]} )); then (cd "$tmp" && "$root/scripts/denylist-check.sh" "$list" "${files[@]}") || { echo "pre-commit: blocked by deny-list"; exit 1; }
  fi
else
  echo "pre-commit: no ~/.config/cyd32/denylist.txt, deny-list check skipped" >&2
fi
"$root/scripts/guard.sh" >/dev/null || { "$root/scripts/guard.sh"; exit 1; }
