# Not installed by the .deb. APPLaunch owns the LCD and the keypad.
# Enabling this unit beside APPLaunch draws a second UI on the same
# framebuffer. Do not stop LightDM and do not stop APPLaunch to use it.
[Unit]
Description=CYD32 sonar (CardputerZero)
After=network.target

[Service]
# The UI stays unprivileged. Create a system user with no shell first:
#   groupadd --system cyd32
#   useradd --system --gid cyd32 --home-dir /nonexistent --shell /usr/sbin/nologin cyd32
# Install the helper as root:cyd32 mode 0750, then setcap. File capabilities
# cannot be passed on if NoNewPrivileges is true.
NoNewPrivileges=false
User=cyd32
ExecStart=/usr/share/APPLaunch/bin/cyd32-ui --awus --helper /usr/share/APPLaunch/bin/cyd32-awus-helper
Restart=on-failure
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_BLUETOOTH

[Install]
WantedBy=multi-user.target
